{
	"name": "pi-desktop",
	"productName": "Pi Desktop",
	"version": "0.4.0",
	"description": "Cross-platform desktop app for the pi coding agent, built with the pi SDK and Electron",
	"type": "module",
	"main": "src/main/index.js",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "electron .",
		"dev": "electron . --dev",
		"test": "vitest --run",
		"build": "electron-builder",
		"build:win": "electron-builder --win",
		"build:mac": "electron-builder --mac",
		"build:linux": "electron-builder --linux",
		"package:dir": "electron-builder --dir",
		"repack:asar": "node scripts/repack-asar.mjs",
		"make-icons": "node scripts/make-icons.mjs",
		"vendor:hljs": "esbuild node_modules/highlight.js/lib/index.js --bundle --format=iife --global-name=hljs --platform=browser --minify --outfile=src/renderer/vendor/highlight.js"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.84.4",
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"marked": "15.0.12"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"electron": "37.2.0",
		"electron-builder": "25.1.8",
		"esbuild": "^0.28.2",
		"highlight.js": "10.7.3",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
